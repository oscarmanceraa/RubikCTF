# ------------------------------------------------------------------
# RUBIK CTF - variables de entorno para PRODUCCION (Ubuntu Server).
# Copia este archivo a .env y edita los valores.
#   cp .env.prod.example .env
# ------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=pon-una-clave-aleatoria-larga-de-50-caracteres-aqui
DJANGO_DEBUG=False
# Incluye la IP de la VM en la red (ej. 192.168.1.50)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50

# Origenes de confianza (CSRF del admin) y CORS. Deben coincidir con la URL de acceso.
CSRF_TRUSTED_ORIGINS=http://192.168.1.50
CORS_ALLOWED_ORIGINS=http://192.168.1.50

# PostgreSQL
POSTGRES_DB=rubikctf
POSTGRES_USER=rubikctf
POSTGRES_PASSWORD=pon-una-password-fuerte-aqui
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Flags: pepper para el hashing (secreto, no compartir)
FLAG_PEPPER=pon-un-pepper-aleatorio-largo-aqui
