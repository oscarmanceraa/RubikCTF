# ------------------------------------------------------------------
# RUBIK CTF - variables de entorno (dev). Copia este archivo a .env
# ------------------------------------------------------------------

# Django
# Usa una cadena aleatoria de al menos 32 caracteres.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga-de-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Para pruebas locales rapidas sin Postgres: USAR_SQLITE=1
# USAR_SQLITE=1

# PostgreSQL
POSTGRES_DB=rubikctf
POSTGRES_USER=rubikctf
POSTGRES_PASSWORD=rubikctf
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS (frontend Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Flags: pepper usado para hashear las flags en la BD (NO compartir)
FLAG_PEPPER=change-me-flag-pepper
